{
  "name": "doc-prep-submission-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP Document Preparation and Submission Agent (local demo, not production ready)",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test",
    "seed": "node dist/src/seed.js",
    "start": "node dist/src/server.js",
    "demo": "npm run build && npm run seed && npm start"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
