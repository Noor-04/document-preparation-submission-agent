# Copy to .env and run with:  node --env-file=.env dist/src/server.js
# This file must never contain a real credential. The demo tokens below are
# deliberately fake and only exist so the local UI has something to log in with.

PORT=3000

# development | production. In production the sandbox adapter is refused outright.
NODE_ENV=development

# Enables the local mock/sandbox portal adapter. Ignored (always refused) when
# NODE_ENV=production. Leave unset for a fail-closed configuration.
ALLOW_SIMULATION=true

# SQLite file. Deleted safely; it is recreated and re-migrated on next start.
DB_FILE=data/app.db

# Deny-by-default destination allowlist. Comma-separated. An entry starting with
# a dot is a suffix rule (".gov.example" matches "portal.gov.example").
# An empty allowlist refuses every destination.
PORTAL_HOST_ALLOWLIST=portal.registry.example,.gov.example

# Resolve destination hosts and refuse private/loopback/link-local addresses.
# Off by default because the demo hosts above intentionally do not resolve.
# Turn this on for any configuration that points at a real host.
PORTAL_DNS_CHECK=false

# Worker poll interval for draining the submission queue.
WORKER_INTERVAL_MS=1000
